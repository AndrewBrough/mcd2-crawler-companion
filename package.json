{
  "name": "mcd2-crawler-companion",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "scrape:weapons": "node --env-file=.env.local scripts/scrape-weapons.mjs",
    "scrape:armor": "node --env-file=.env.local scripts/scrape-armor.mjs",
    "scrape:artifacts": "node --env-file=.env.local scripts/scrape-artifacts.mjs",
    "scrape:talismans": "node --env-file=.env.local scripts/scrape-talismans.mjs",
    "scrape:effects": "node --env-file=.env.local scripts/scrape-effects.mjs",
    "scrape:enchantments": "node --env-file=.env.local scripts/scrape-enchantments.mjs",
    "sync:gear": "node --env-file=.env.local scripts/sync-gear.mjs",
    "sync:locations": "node --env-file=.env.local scripts/sync-locations.mjs",
    "sync:enemies": "node --env-file=.env.local scripts/sync-enemies.mjs",
    "sync:enchantments": "node --env-file=.env.local scripts/sync-enchantments.mjs",
    "sync:gear-enchantments": "node --env-file=.env.local scripts/sync-gear-enchantments.mjs",
    "sync:effects": "node --env-file=.env.local scripts/sync-effects.mjs",
    "sync:catalog": "npm run sync:gear && npm run sync:locations && npm run sync:enemies && npm run sync:enchantments && npm run sync:gear-enchantments && npm run sync:effects"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@supabase/supabase-js": "^2.117.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.2.15",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "supabase": "^2.117.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp"
    ]
  }
}
